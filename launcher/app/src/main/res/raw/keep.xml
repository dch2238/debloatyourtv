<?xml version="1.0" encoding="utf-8"?>
<!-- app_banners names drawables at run time, which resource shrinking cannot see: keep every banner_*.
     Strict: that is the launcher's only getIdentifier, and safe mode also keeps every resource whose name
     matches a string literal anywhere in the code (AndroidX translations among them). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/banner_*,@drawable/cricket_pill_bg,@color/pill_kicker_color,@color/pill_headline_color,@color/pin_key_text,@drawable/pill_text*,@drawable/ic_bluetooth,@drawable/ic_power,@drawable/ic_control_center,@drawable/ic_restart"
    tools:shrinkMode="strict" />
